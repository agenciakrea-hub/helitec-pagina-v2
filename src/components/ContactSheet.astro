---
/**
 * ContactSheet.astro
 * Consorcio Helitec — Panel de contacto deslizante (Bottom Sheet)
 *
 * Referencia visual: aventuradentalarts.com — panel inferior con tarjetas de contacto
 *
 * Estructura:
 *   · Trigger: botón fijo bottom-right con icono de teléfono
 *   · Sheet: panel que sube desde bottom: 0 (translateY 100% → 0)
 *   · Contenido: 3 tarjetas de contacto con acción directa (tel:, wa.me)
 *     1. Oficina Caracas      → llamada directa
 *     2. Operaciones 24/7     → llamada directa
 *     3. Ambulancia Aérea     → WhatsApp directo
 *
 * Reglas anti-slop:
 *   border-radius: var(--r-micro) solo en esquinas superiores del sheet
 *   z-index: var(--z-bottom-sheet) = 900
 *   PROHIBIDO box-shadow — ✓
 *
 * NOTA PARA EL CLIENTE: Reemplazar los números de contacto con los reales.
 *   Los marcados con [NÚMERO] son placeholders.
 */

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
---

<!-- ── BACKDROP ──────────────────────────────────────────────────────────── -->
<div
  class="csheet__backdrop"
  id="csheet-backdrop"
  aria-hidden="true"
></div>

<!-- ── BOTTOM SHEET ──────────────────────────────────────────────────────── -->
<div
  class="csheet__sheet"
  id="csheet-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Información de contacto"
  aria-hidden="true"
>
  <!-- Handle — barra de arrastre visual -->
  <div class="csheet__handle-wrap" aria-hidden="true">
    <span class="csheet__handle"></span>
  </div>

  <!-- Cabecera del sheet — solo título (overline eliminado) -->
  <div class="csheet__header">
    <div class="csheet__header-text">
      <h2 class="csheet__title">Contáctenos</h2>
    </div>
    <button
      class="csheet__close"
      id="csheet-close"
      type="button"
      aria-label="Cerrar panel de contacto"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
      </svg>
    </button>
  </div>

  <!-- Tarjetas de contacto — 2 líneas: Título + Subtítulo -->
  <div class="csheet__cards">

    <!-- 00 — WhatsApp General -->
    <a
      href="https://wa.me/584122427837?text=Escribo+desde+la+pagina+web+de+helitec.+Quiero+que+me+asesoren."
      class="csheet__card csheet__card--whatsapp"
      target="_blank"
      rel="noopener noreferrer"
      data-type="whatsapp"
    >
      <span class="csheet__card-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.52 3.48A11.9 11.9 0 0 0 12 0C5.37 0 0 5.37 0 12c0 2.12.55 4.18 1.6 6L0 24l6.17-1.57A11.94 11.94 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.22-3.48-8.52ZM12 21.94a9.9 9.9 0 0 1-5.04-1.37l-.36-.22-3.66.94.97-3.56-.24-.37A9.9 9.9 0 0 1 2.06 12C2.06 6.49 6.49 2.06 12 2.06S21.94 6.49 21.94 12 17.51 21.94 12 21.94Zm5.44-7.42c-.3-.15-1.76-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.14-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.03 1.01-1.03 2.46s1.06 2.85 1.2 3.05c.15.2 2.08 3.18 5.04 4.46.7.3 1.25.48 1.68.62.7.22 1.34.19 1.85.11.56-.08 1.76-.72 2-1.41.25-.7.25-1.3.18-1.42-.07-.12-.27-.2-.57-.34Z" fill="currentColor"/>
        </svg>
      </span>
      <div class="csheet__card-info">
        <span class="csheet__card-label">Escribir por Whatsapp</span>
        <span class="csheet__card-value">(+58) 412 2427837</span>
      </div>
      <span class="csheet__card-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </span>
    </a>

    <!-- 01 — Llamada Oficina -->
    <a
      href="tel:+582129596385"
      class="csheet__card"
      data-type="phone"
    >
      <span class="csheet__card-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .948.684l1.498 4.493a1 1 0 0 1-.502 1.21L8.5 10.5a11.042 11.042 0 0 0 4.998 5l1.113-1.724a1 1 0 0 1 1.21-.502l4.493 1.498A1 1 0 0 1 21 15.72V19a2 2 0 0 1-2 2h-1C9.163 21 3 14.837 3 7V5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="csheet__card-info">
        <span class="csheet__card-label">Realizar Llamada</span>
        <span class="csheet__card-value">(+58) 212 9596385</span>
      </div>
      <span class="csheet__card-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </span>
    </a>

    <!-- 02 — Correo Electrónico -->
    <a
      href="mailto:info@helitec-main.com"
      class="csheet__card"
      data-type="email"
    >
      <span class="csheet__card-icon" aria-hidden="true">
        <!-- Ícono sobre/email -->
        <svg width="20" height="16" viewBox="0 0 24 19" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="22" height="17" rx="1" stroke="currentColor" stroke-width="1.5"/>
          <path d="M1 4l11 8 11-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </span>
      <div class="csheet__card-info">
        <span class="csheet__card-label">Contactar por Email</span>
        <span class="csheet__card-value">info@helitec-main.com</span>
      </div>
      <span class="csheet__card-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </span>
    </a>

    <!-- 03 — Traslado Médico Aéreo (WhatsApp) -->
    <a
      href="https://wa.me/584241466595?text=Vengo+de+la+pagina+de+Helitec.+Quiero+informacion+sobre+los+Servicios+de+Aeroambulancia."
      class="csheet__card csheet__card--urgent"
      target="_blank"
      rel="noopener noreferrer"
      data-type="whatsapp"
    >
      <span class="csheet__card-icon" aria-hidden="true">
        <!-- Cruz médica en círculo -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L12 22M2 12L22 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <div class="csheet__card-info">
        <span class="csheet__card-label">Traslado medico aereo</span>
        <span class="csheet__card-value">(+58) 424 1466595</span>
      </div>
      <span class="csheet__card-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
        </svg>
      </span>
    </a>

  </div>

  <!-- Footer del sheet — logo en lugar de texto -->
  <div class="csheet__footer">
    <img
      src="/assets/Logo-Helitec-Vert-no-bkg-1-blanco.png"
      alt="Consorcio Helitec"
      class="csheet__footer-logo"
      loading="lazy"
      decoding="async"
    />
  </div>

</div>

<!-- ── Contacto strip — scroll-triggered, píldora vertical igual a Cotización ─────
  position: fixed · right: 0 · bottom: 104px · z-index: 893
  Oculto sobre el Hero; slide-in desde la derecha al salir.
  Scroll trigger manejado por SideLeadCTA.astro junto con Cotización.
──────────────────────────────────────────────────────────────────────────────── -->
<button
  class="csheet__contact-strip"
  id="csheet-trigger"
  type="button"
  aria-expanded="false"
  aria-controls="csheet-sheet"
  aria-label="Abrir información de contacto"
>
  <span class="csheet__contact-icon" aria-hidden="true">
    <svg width="16" height="15" viewBox="0 0 18 17" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 1h16v10H4.5L1 15V1Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" stroke-linejoin="miter"/>
    </svg>
  </span>
  <span class="csheet__contact-strip-text" aria-hidden="true">CONTACTO</span>
</button>

<!-- ── Linktree — logo avión, siempre visible ──────────────────────────────────
  position: fixed · right: 0 · bottom: 24px · z-index: 890
  Tooltip "Nuestro Linktree" aparece al cargar y se desvanece sola (CSS puro).
──────────────────────────────────────────────────────────────────────────────── -->
<a
  class="csheet__linktree-btn"
  href="https://linktr.ee/helitec"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Ver todas las redes de Consorcio Helitec en Linktree"
>
  <span class="csheet__fab-label" aria-hidden="true">Ver Linktree&nbsp;<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span>
  <img
    src="/assets/recurso logo avion helitec (1).png"
    alt=""
    class="csheet__linktree-img"
    loading="eager"
    decoding="async"
    aria-hidden="true"
  />
</a>


<style>
  /* ── BACKDROP ───────────────────────────────────────────────────────────── */
  .csheet__backdrop {
    position:       fixed;
    inset:          0;
    z-index:        898; /* Debajo del sheet (899) */

    background-color: rgba(7, 8, 12, 0.70);

    opacity:        0;
    pointer-events: none;
    visibility:     hidden;

    transition:
      opacity    var(--dur-mid) var(--ease-out),
      visibility 0s linear calc(var(--dur-mid) + 10ms);
  }

  .csheet__backdrop.is-open {
    opacity:        1;
    pointer-events: auto;
    visibility:     visible;
    transition:
      opacity    var(--dur-mid) var(--ease-out),
      visibility 0s linear 0s;
  }

  /* ── SHEET ──────────────────────────────────────────────────────────────── */
  .csheet__sheet {
    position: fixed;
    bottom:   0;
    left:     0;
    right:    0;

    z-index:  var(--z-bottom-sheet); /* 900 */

    background-color: var(--c-bg-raised);

    /* Esquinas superiores: 4px — límite absoluto del proyecto */
    border-radius: var(--r-micro) var(--r-micro) 0 0;
    border-top:    1px solid var(--c-line-strong);

    /* Slide desde abajo */
    transform:  translateY(100%);
    visibility: hidden;

    transition:
      transform  var(--dur-mid) var(--ease-menu),
      visibility 0s linear calc(var(--dur-mid) + 10ms);

    /* Limitar altura en pantallas grandes */
    max-height: 85dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .csheet__sheet.is-open {
    transform:  translateY(0);
    visibility: visible;
    transition:
      transform  var(--dur-mid) var(--ease-menu),
      visibility 0s linear 0s;
  }

  /* ── Handle ─────────────────────────────────────────────────────────────── */
  .csheet__handle-wrap {
    display:         flex;
    justify-content: center;
    padding-top:     14px;
    padding-bottom:  8px;
  }

  .csheet__handle {
    display:          block;
    width:            32px;
    height:           3px;
    background-color: var(--c-line-strong);
    border-radius:    var(--r-micro); /* 4px */
  }

  /* ── Cabecera ────────────────────────────────────────────────────────────── */
  .csheet__header {
    display:     flex;
    align-items: center;
    justify-content: space-between;

    padding: 8px clamp(20px, 5vw, 36px) 20px;
    border-bottom: 1px solid var(--c-line);
  }

  .csheet__title {
    font-family:    var(--font-display);
    font-size:      clamp(1.4rem, 3vw, 1.75rem);
    font-weight:    var(--fw-regular); /* v2: thin → regular — más presencia */
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color:          var(--c-text-1);
  }

  .csheet__close {
    display:         flex;
    align-items:     center;
    justify-content: center;

    width:  36px;
    height: 36px;
    flex-shrink: 0;

    background:    none;
    border:        1px solid var(--c-line);
    border-radius: var(--r-micro);
    cursor:        pointer;
    color:         var(--c-text-2);

    transition: border-color var(--dur-fast) var(--ease-out),
                color        var(--dur-fast) var(--ease-out);
  }

  .csheet__close:hover {
    border-color: var(--c-line-strong);
    color:        var(--c-text-1);
  }

  .csheet__close:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
  }

  /* ── Tarjetas ────────────────────────────────────────────────────────────── */
  .csheet__cards {
    display:        flex;
    flex-direction: column;

    /* Líneas divisoras entre tarjetas sin border */
    gap:            1px;
    background-color: var(--c-line);

    border-bottom: 1px solid var(--c-line);
  }

  .csheet__card {
    display:     flex;
    align-items: center;
    gap:         16px;

    padding: 18px clamp(20px, 5vw, 36px);

    background-color: var(--c-bg-raised);
    text-decoration:  none;
    color:            inherit;

    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .csheet__card:hover {
    background-color: var(--c-bg);
  }

  /* ── Marco de ícono — borde y fondo UNIFICADO en las 4 tarjetas ───────
   * El color del marco es idéntico para todos. Solo el color del ícono
   * (currentColor) varía para mantener la identidad de cada canal.
   */
  .csheet__card-icon {
    display:         flex;
    align-items:     center;
    justify-content: center;
    flex-shrink:     0;

    width:  44px;
    height: 44px;

    background-color: rgba(255, 255, 255, 0.05); /* fondo sutil uniforme */
    border:           1px solid rgba(255, 255, 255, 0.14); /* = var(--c-line-strong) */
    border-radius:    var(--r-micro);
    color:            var(--c-sky); /* color por defecto — override por tipo abajo */
  }

  /* WhatsApp — ícono verde WA */
  .csheet__card--whatsapp .csheet__card-icon {
    color: #25D366;
  }

  /* Emergencias — ícono rojo */
  .csheet__card--urgent .csheet__card-icon {
    color: var(--c-red);
  }

  .csheet__card-info {
    display:        flex;
    flex-direction: column;
    gap:            2px;
    flex:           1;
    min-width:      0;
  }

  .csheet__card-label {
    font-family:    var(--font-sans);
    font-size:      var(--text-sm);    /* v2: xs → sm — más legible */
    font-weight:    600;               /* v2: medium → semibold */
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color:          var(--c-text-2);   /* v2: text-3 → text-2 — más contraste */
  }

  .csheet__card-value {
    font-family: var(--font-display);
    font-size:   clamp(0.95rem, 2vw, 1.1rem); /* v2: subido */
    font-weight: 500;                          /* v2: regular → medium */
    color:       var(--c-text-1);
    white-space: nowrap;
    overflow:    hidden;
    text-overflow: ellipsis;
  }

  .csheet__card-arrow {
    flex-shrink: 0;
    color:       var(--c-text-3);
    transition:  transform var(--dur-fast) var(--ease-out),
                 color     var(--dur-fast) var(--ease-out);
  }

  .csheet__card:hover .csheet__card-arrow {
    transform: translateX(3px);
    color:     var(--c-text-2);
  }

  /* ── Divisor y footer ────────────────────────────────────────────────────── */
  .csheet__divider {
    height:           1px;
    background-color: var(--c-line);
  }

  .csheet__footer {
    padding:    16px clamp(20px, 5vw, 36px) 28px;
    display:    flex;
    justify-content: center;
  }

  .csheet__footer-logo {
    height:     36px;
    width:      auto;
    object-fit: contain;
    opacity:    0.55; /* sutil — no compite con el contenido */
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .csheet__footer-logo:hover {
    opacity: 0.80;
  }

  /* ════════════════════════════════════════════════════════════════════════
     CONTACTO STRIP — scroll-triggered, píldora vertical (igual a Cotización)
     position: fixed · right: 0 · bottom: 104px · z-index: 893
     Cálculo bottom: 24px base + 72px imagen Linktree + 8px gap = 104px
     El scroll trigger JS vive en SideLeadCTA.astro junto con Cotización.
  ════════════════════════════════════════════════════════════════════════ */

  .csheet__contact-strip {
    position: fixed;
    right:    0;
    bottom:   109px; /* 24px base + 65px Linktree + 20px gap */
    z-index:  992; /* encima de Linktree (990) y Cotización (991) */

    width:   44px;
    height:  134px;
    padding: 12px 0; /* idéntico a Cotización */

    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             8px;

    background:    rgba(15, 60, 30, 0.55);
    border:        1px solid rgba(40, 160, 90, 0.22);
    border-right:  none;
    border-radius: 4px 0 0 4px;
    color:         rgba(255, 255, 255, 0.75);
    cursor:        pointer;

    /* SCROLL TRIGGER — estado inicial: off-screen derecha + invisible */
    transform:      translateX(calc(100% + 2px));
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;

    transition:
      transform    0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity      0.40s var(--ease-out),
      visibility   0s   linear 0.40s,
      background   var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  /* ESTADO VISIBLE — slide-in al pasar el Hero */
  .csheet__contact-strip.is-visible {
    transform:      translateX(0);
    opacity:        1;
    visibility:     visible;
    pointer-events: auto;

    transition:
      transform    0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity      0.40s var(--ease-out),
      visibility   0s   linear 0s,
      background   var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .csheet__contact-strip:hover {
    background:   rgba(15, 60, 30, 0.80);
    border-color: rgba(40, 160, 90, 0.45);
    color:        var(--c-white);
  }

  .csheet__contact-strip:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
  }

  .csheet__contact-strip[aria-expanded="true"] {
    background:   rgba(20, 80, 40, 0.85);
    border-color: rgba(40, 160, 90, 0.55);
  }

  /* Texto vertical permanente */
  .csheet__contact-strip-text {
    writing-mode:     vertical-rl;
    text-orientation: mixed;
    transform:        rotate(180deg);

    font-family:    var(--font-sans);
    font-size:      8.5px;
    font-weight:    var(--fw-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color:          inherit;
    white-space:    nowrap;
  }

  .csheet__contact-icon {
    display:         flex;
    align-items:     center;
    justify-content: center;
    flex-shrink:     0;
  }

  /* Ocultar Contacto cuando el menú principal está abierto */
  :global(body.menu-is-open)   .csheet__contact-strip,
  :global(body.menu-is-closing) .csheet__contact-strip {
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      opacity    0.20s var(--ease-out),
      visibility 0s    linear 0.20s;
  }

  /* Ocultar Contacto cuando el cotizador (SideLeadCTA) está abierto */
  :global(body.slcta-is-open) .csheet__contact-strip {
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      opacity    0.20s var(--ease-out),
      visibility 0s    linear 0.20s;
  }

  /* ════════════════════════════════════════════════════════════════════════
     LINKTREE — logo avión, siempre visible
     position: fixed · right: 0 · bottom: 24px · z-index: 890
  ════════════════════════════════════════════════════════════════════════ */

  .csheet__linktree-btn {
    position: fixed;
    right:    0;
    bottom:   24px;
    z-index:  990; /* por debajo de Contacto (992) y Cotización (991) */

    display:         block;
    cursor:          pointer;
    text-decoration: none;
  }

  .csheet__linktree-img {
    width:      65px;
    height:     65px;
    display:    block;
    object-fit: contain;
    opacity:    0.80;

    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .csheet__linktree-btn:hover .csheet__linktree-img { opacity: 1; }

  .csheet__linktree-btn:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
  }

  /* Ocultar Linktree cuando el menú principal está abierto */
  :global(body.menu-is-open)   .csheet__linktree-btn,
  :global(body.menu-is-closing) .csheet__linktree-btn {
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      opacity    0.20s var(--ease-out),
      visibility 0s    linear 0.20s;
  }

  /* Ocultar Linktree cuando el cotizador está abierto */
  :global(body.slcta-is-open) .csheet__linktree-btn {
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      opacity    0.20s var(--ease-out),
      visibility 0s    linear 0.20s;
  }

  /* Ocultar los 3 flotantes cuando el panel de Contacto está abierto */
  :global(body.csheet-is-open) .csheet__contact-strip,
  :global(body.csheet-is-open) .csheet__linktree-btn {
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      opacity    0.20s var(--ease-out),
      visibility 0s    linear 0.20s;
  }


  /* ════════════════════════════════════════════════════════════════════════
     TOOLTIP ONBOARDING — "Nuestro Linktree"
     Aparece al cargar la página y se desvanece sola (CSS puro, sin JS).
     Aparece a la izquierda del botón con mini-flecha apuntando hacia él.
  ════════════════════════════════════════════════════════════════════════ */

  @keyframes fab-label-show {
    0%   { opacity: 0; transform: translateY(-50%) translateX(8px); }
    8%   { opacity: 1; transform: translateY(-50%) translateX(0);   }
    85%  { opacity: 1; transform: translateY(-50%) translateX(0);   }
    100% { opacity: 0; transform: translateY(-50%) translateX(4px); }
  }

  .csheet__fab-label {
    position:       absolute;
    right:          calc(100% + 10px); /* a la izquierda del botón */
    top:            50%;

    white-space:    nowrap;
    pointer-events: none;
    user-select:    none;

    font-family:    var(--font-sans);
    font-size:      10px;
    font-weight:    var(--fw-medium);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color:          var(--c-white);

    background:              rgba(7, 8, 12, 0.82);
    backdrop-filter:         blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border:        1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-micro);
    padding:       5px 10px;

    opacity:         0;
    animation:       fab-label-show 3.5s ease forwards;
    animation-delay: 0.85s;
  }

  /* Mini-flecha apuntando hacia el botón (derecha) */
  .csheet__fab-label::after {
    content:  '';
    position: absolute;
    right:    -5px;
    top:      50%;
    transform: translateY(-50%);

    width:  0;
    height: 0;
    border-top:    4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left:   5px solid rgba(7, 8, 12, 0.82);
  }
</style>


<script>
  /* Scroll trigger de COTIZACIÓN movido a SideLeadCTA.astro */

  /**
   * ContactSheet — Controller
   *
   * Maneja open/close del bottom sheet.
   * Cierra con: clic backdrop, botón ✕, tecla Escape.
   * Previene scroll de fondo cuando está abierto.
   */
  (function () {
    const trigger  = document.getElementById('csheet-trigger');
    const sheet    = document.getElementById('csheet-sheet');
    const backdrop = document.getElementById('csheet-backdrop');
    const closeBtn = document.getElementById('csheet-close');

    if (!trigger || !sheet || !backdrop) return;

    let isOpen = false;

    function open() {
      isOpen = true;
      sheet.classList.add('is-open');
      backdrop.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
      trigger.setAttribute('aria-label', 'Cerrar información de contacto');
      sheet.setAttribute('aria-hidden', 'false');
      document.body.classList.add('csheet-is-open'); /* overflow vía reset.css */

      /* Foco al primer elemento interactivo */
      setTimeout(() => {
        const first = sheet.querySelector('a, button');
        if (first) first.focus();
      }, 460);
    }

    function close() {
      isOpen = false;
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.setAttribute('aria-label', 'Abrir información de contacto');
      sheet.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('csheet-is-open');
      trigger.focus();
    }

    trigger.addEventListener('click', () => isOpen ? close() : open());
    backdrop.addEventListener('click', close);
    if (closeBtn) closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        close();
      }
    });

    /* Touch swipe down → cierra (UX mobile mejorado) */
    let startY = 0;
    sheet.addEventListener('touchstart', (e) => {
      startY = e.touches[0].clientY;
    }, { passive: true });

    sheet.addEventListener('touchend', (e) => {
      const endY = e.changedTouches[0].clientY;
      if (endY - startY > 80 && isOpen) close(); /* 80px swipe down */
    }, { passive: true });

  })();
</script>
