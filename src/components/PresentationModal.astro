---
/**
 * PresentationModal.astro
 * Consorcio Helitec — Nota estratégica del rediseño web
 *
 * Botón flotante bottom-left visible solo cuando el footer entra en viewport.
 * Al hacer clic, abre un modal con el resumen estratégico de la entrega.
 * Componente de presentación al cliente — no es UI de producción permanente.
 */
---

<!-- ── Botón flotante ────────────────────────────────────────────────────────── -->
<button
  class="pm-trigger"
  id="pm-trigger"
  type="button"
  aria-label="Ver aclaraciones del rediseño web"
  aria-controls="pm-modal"
  aria-expanded="false"
>
  <!-- Ícono: documento con líneas -->
  <svg
    class="pm-trigger__icon"
    width="18" height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
    <polyline points="14 2 14 8 20 8"/>
    <line x1="16" y1="13" x2="8" y2="13"/>
    <line x1="16" y1="17" x2="8" y2="17"/>
    <line x1="10" y1="9"  x2="8" y2="9"/>
  </svg>
  <span class="pm-trigger__label">Aclaraciones del rediseño web</span>
</button>


<!-- ── Modal ─────────────────────────────────────────────────────────────────── -->
<div
  class="pm-modal"
  id="pm-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pm-modal-title"
  aria-hidden="true"
>
  <!-- Overlay / backdrop -->
  <div class="pm-modal__overlay" id="pm-overlay" aria-hidden="true"></div>

  <!-- Caja central -->
  <div class="pm-modal__box" role="document">

    <!-- Encabezado -->
    <div class="pm-modal__header">
      <h2 class="pm-modal__title" id="pm-modal-title">
        Resumen Estratégico del Rediseño
      </h2>
      <button
        class="pm-modal__close"
        id="pm-close"
        type="button"
        aria-label="Cerrar modal"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6"  x2="6"  y2="18"/>
          <line x1="6"  y1="6"  x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Cuerpo scrollable -->
    <div class="pm-modal__body">
      <ul class="pm-modal__list">

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Alcance de la Fase Inicial:</strong> Esta entrega contempla el diseño funcional de la página Principal (Inicio), el ecosistema de enlaces corporativos (Linktree) y la sección de Seguridad y Calidad. Las demás subpáginas se diseñarán en la siguiente etapa.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Visión Estratégica:</strong> Estructura y narrativa visual adaptadas milimétricamente al nuevo enfoque comercial que Helitec busca proyectar.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Enfoque Mobile-First:</strong> Arquitectura orientada a una experiencia móvil limpia, moderna y corporativa. <em>(Nota: El diseño de escritorio es un prototipo funcional que se afinará tras la aprobación).</em></p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Automatización de Contacto:</strong> Cada botón de conversión acciona un mensaje preconfigurado en WhatsApp, agilizando el embudo de ventas.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Autoridad y Confianza:</strong> Foco estratégico en la comunicación de licencias y el estricto cumplimiento de los estándares de líneas aéreas.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Rendimiento Extremo:</strong> Código optimizado para una carga ultrarrápida, garantizando fluidez en conexiones de internet inestables o lentas.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Identidad Corporativa:</strong> Alineación total con el manual de marca y la línea gráfica de Helitec.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Infraestructura de Datos:</strong> Base preparada para la integración de Google Tag (conteo de métricas).</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Migración SEO y URLs Limpias:</strong> Mapeo integral de la web anterior para implementar redirecciones 301. Preservaremos el SEO en Google y eliminaremos rutas obsoletas, transformando enlaces nocivos como <code>index.php?bandera=1</code> en URLs modernas.</p>
        </li>

        <li class="pm-modal__item">
          <span class="pm-modal__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <p><strong>Mantenimiento Ágil:</strong> Arquitectura flexible que permite un soporte personalizado, rápido y la fácil reubicación de nuevo material.</p>
        </li>

      </ul>
    </div><!-- /pm-modal__body -->

  </div><!-- /pm-modal__box -->
</div><!-- /pm-modal -->


<style>
  /* ════════════════════════════════════════════════════════════════════════
     BOTÓN FLOTANTE
  ════════════════════════════════════════════════════════════════════════ */

  .pm-trigger {
    position: fixed;
    left:     24px;
    bottom:   24px;
    z-index:  980;

    display:        inline-flex;
    align-items:    center;
    gap:            10px;

    padding:        10px 16px;
    border:         1.5px solid rgba(52, 211, 153, 0.70);
    border-radius:  4px;
    background:     #065f46; /* emerald-800 — verde corporativo intenso */
    color:          #ecfdf5;
    cursor:         pointer;

    /* Transición de aparición (scroll trigger) */
    transform:      translateY(16px);
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      transform    0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity      0.35s ease-out,
      visibility   0s   linear 0.35s,
      background   0.2s ease-out,
      border-color 0.2s ease-out;

    /* Pulso de atención (llama la atención sin neón) */
    animation: pm-pulse 2.4s ease-in-out infinite;
  }

  .pm-trigger.is-visible {
    transform:      translateY(0);
    opacity:        1;
    visibility:     visible;
    pointer-events: auto;
    transition:
      transform    0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity      0.35s ease-out,
      visibility   0s   linear 0s,
      background   0.2s ease-out,
      border-color 0.2s ease-out;
  }

  .pm-trigger:hover {
    background:   #047857; /* emerald-700 */
    border-color: rgba(52, 211, 153, 0.95);
  }

  .pm-trigger:focus-visible {
    outline:        2px solid #34d399;
    outline-offset: 3px;
  }

  @keyframes pm-pulse {
    0%, 100% {
      border-color: rgba(52, 211, 153, 0.70);
      filter: drop-shadow(0 0 0px rgba(52, 211, 153, 0));
    }
    50% {
      border-color: rgba(52, 211, 153, 1);
      filter: drop-shadow(0 0 6px rgba(52, 211, 153, 0.45));
    }
  }

  .pm-trigger__icon {
    flex-shrink: 0;
    width:       18px;
    height:      18px;
  }

  .pm-trigger__label {
    font-family:    var(--font-sans);
    font-size:      var(--text-xs);
    font-weight:    var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height:    1;
    white-space:    nowrap;
  }


  /* ════════════════════════════════════════════════════════════════════════
     MODAL — OVERLAY
  ════════════════════════════════════════════════════════════════════════ */

  .pm-modal {
    position: fixed;
    inset:    0;
    z-index:  1100;

    display:         flex;
    align-items:     center;
    justify-content: center;
    padding:         24px 16px;

    /* Oculto por defecto */
    opacity:        0;
    visibility:     hidden;
    pointer-events: none;
    transition:
      opacity    0.30s ease-out,
      visibility 0s   linear 0.30s;
  }

  .pm-modal.is-open {
    opacity:        1;
    visibility:     visible;
    pointer-events: auto;
    transition:
      opacity    0.30s ease-out,
      visibility 0s   linear 0s;
  }

  .pm-modal__overlay {
    position:   absolute;
    inset:      0;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter:         blur(8px) saturate(0.8);
    -webkit-backdrop-filter: blur(8px) saturate(0.8);
  }


  /* ════════════════════════════════════════════════════════════════════════
     MODAL — CAJA
  ════════════════════════════════════════════════════════════════════════ */

  .pm-modal__box {
    position:     relative; /* encima del overlay */
    z-index:      1;

    width:        100%;
    max-width:    600px;
    max-height:   85dvh;

    display:        flex;
    flex-direction: column;

    background:   #0d2117;
    border:       1px solid rgba(52, 211, 153, 0.22);
    border-radius: 4px;

    transform:   translateY(12px);
    transition:  transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pm-modal.is-open .pm-modal__box {
    transform: translateY(0);
  }


  /* ════════════════════════════════════════════════════════════════════════
     MODAL — ENCABEZADO
  ════════════════════════════════════════════════════════════════════════ */

  .pm-modal__header {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             16px;

    padding:      20px 24px 16px;
    border-bottom: 1px solid rgba(52, 211, 153, 0.15);
    flex-shrink:  0;
  }

  .pm-modal__title {
    font-family:    var(--font-display, var(--font-sans));
    font-size:      var(--text-md);
    font-weight:    var(--fw-light);
    letter-spacing: var(--ls-wide);
    color:          #ecfdf5;
    margin:         0;
  }

  .pm-modal__close {
    display:         flex;
    align-items:     center;
    justify-content: center;
    flex-shrink:     0;

    width:    32px;
    height:   32px;
    padding:  0;

    background:    none;
    border:        1px solid rgba(52, 211, 153, 0.25);
    border-radius: 4px;
    color:         rgba(209, 250, 229, 0.70);
    cursor:        pointer;

    transition:
      background   0.2s ease-out,
      border-color 0.2s ease-out,
      color        0.2s ease-out;
  }

  .pm-modal__close:hover {
    background:   rgba(52, 211, 153, 0.10);
    border-color: rgba(52, 211, 153, 0.55);
    color:        #ecfdf5;
  }

  .pm-modal__close:focus-visible {
    outline:        2px solid #34d399;
    outline-offset: 2px;
  }


  /* ════════════════════════════════════════════════════════════════════════
     MODAL — CUERPO SCROLLABLE
  ════════════════════════════════════════════════════════════════════════ */

  .pm-modal__body {
    overflow-y:  auto;
    padding:     20px 24px 24px;
    flex:        1;

    /* Scrollbar sutil */
    scrollbar-width:      thin;
    scrollbar-color:      rgba(52, 211, 153, 0.30) transparent;
  }

  .pm-modal__body::-webkit-scrollbar       { width: 4px; }
  .pm-modal__body::-webkit-scrollbar-track { background: transparent; }
  .pm-modal__body::-webkit-scrollbar-thumb { background: rgba(52, 211, 153, 0.30); border-radius: 2px; }


  /* ════════════════════════════════════════════════════════════════════════
     MODAL — LISTA DE PUNTOS
  ════════════════════════════════════════════════════════════════════════ */

  .pm-modal__list {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        14px;
  }

  .pm-modal__item {
    display:    flex;
    align-items: flex-start;
    gap:        12px;
  }

  .pm-modal__check {
    flex-shrink: 0;
    display:     flex;
    align-items: center;
    justify-content: center;

    width:   22px;
    height:  22px;
    margin-top: 1px;

    background:    rgba(52, 211, 153, 0.14);
    border:        1px solid rgba(52, 211, 153, 0.35);
    border-radius: 4px;
    color:         #34d399;
  }

  .pm-modal__item p {
    font-family:  var(--font-sans);
    font-size:    var(--text-sm);
    font-weight:  var(--fw-light);
    line-height:  1.70;
    color:        rgba(209, 250, 229, 0.80);
    margin:       0;
  }

  .pm-modal__item strong {
    font-weight: var(--fw-semibold);
    color:       #ecfdf5;
  }

  .pm-modal__item em {
    font-style: italic;
    color:      rgba(209, 250, 229, 0.60);
  }

  .pm-modal__item code {
    font-family:    monospace;
    font-size:      0.85em;
    background:     rgba(52, 211, 153, 0.10);
    border:         1px solid rgba(52, 211, 153, 0.20);
    border-radius:  2px;
    padding:        1px 5px;
    color:          #6ee7b7;
  }


  /* ════════════════════════════════════════════════════════════════════════
     MOBILE
  ════════════════════════════════════════════════════════════════════════ */

  @media (max-width: 480px) {
    .pm-trigger__label { display: none; }
    .pm-trigger        { padding: 10px 12px; }

    .pm-modal__header  { padding: 16px 16px 12px; }
    .pm-modal__body    { padding: 16px 16px 20px; }
    .pm-modal__title   { font-size: var(--text-base); }
  }
</style>


<script>
  (function () {
    'use strict';

    var trigger  = document.getElementById('pm-trigger');
    var modal    = document.getElementById('pm-modal');
    var closeBtn = document.getElementById('pm-close');
    var overlay  = document.getElementById('pm-overlay');

    if (!trigger || !modal) return;

    /* ── Aparición del botón — anclado al footer ─────────────────────── */
    var footer = document.querySelector('[data-footer]');

    if (footer && 'IntersectionObserver' in window) {
      var footerObs = new IntersectionObserver(
        function (entries) {
          if (entries[0].isIntersecting) {
            trigger.classList.add('is-visible');
          } else {
            trigger.classList.remove('is-visible');
          }
        },
        { threshold: 0 }
      );
      footerObs.observe(footer);
    }

    /* ── Abrir modal ─────────────────────────────────────────────────── */
    function openModal() {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      /* Foco al botón de cierre */
      setTimeout(function () {
        if (closeBtn) closeBtn.focus();
      }, 50);
    }

    /* ── Cerrar modal ────────────────────────────────────────────────── */
    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      trigger.focus();
    }

    trigger.addEventListener('click', openModal);
    if (closeBtn)  closeBtn.addEventListener('click', closeModal);
    if (overlay)   overlay.addEventListener('click', closeModal);

    /* Escape para cerrar */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

  })();
</script>
