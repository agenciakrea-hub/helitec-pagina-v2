---
/**
 * Footer.astro — Consorcio Helitec  v3 (Mobile-First Redesign)
 *
 * CAMBIOS v3:
 *   - Layout Mobile bifurcado en 2 mitades:
 *     SUPERIOR: grid 2 columnas (brand | nav+contacto)
 *     INFERIOR: grid 2×2 tarjetas blancas sociales + 2 botones CTA pill
 *   - Social cards: fondo blanco, ícono stroke centrado, label abajo
 *     Referencia: captura adjunta (estilo Awwwards/Clutch cards)
 *   - Botón "SOLICITAR COTIZACIÓN" duplicado del CONTACTAR (mismo ancho/estilo)
 *   - Desktop (≥1024px): grid 3 columnas original vía display:contents en
 *     footer__col-right
 *
 * Reglas anti-slop:
 *   PROHIBIDO box-shadow        — ✓
 *   PROHIBIDO linear-gradient   — ✓
 *   border-radius ≤ 4px         — ✓ (excepto .footer__pill-cta: 999px, override Tech Lead)
 *   object-fit: cover/contain   — ✓
 */

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const navLinks = [
  { href: '#por-que-helitec', label: lang === 'es' ? 'Por qué Helitec' : 'Why Helitec' },
  { href: '#flota',           label: lang === 'es' ? 'Nuestra Flota'   : 'Our Fleet'   },
  { href: '#empresa',         label: lang === 'es' ? 'La Empresa'       : 'About Us'    },
  { href: '#seguridad',       label: lang === 'es' ? 'Seguridad'        : 'Safety'      },
  { href: '#contacto',        label: lang === 'es' ? 'Contacto B2B'     : 'B2B Contact' },
];

const logoSrc   = '/assets/Logo-Helitec-horiz-no-bkg-1-blanco.png';
const currentYear = new Date().getFullYear();
---


<footer
  class="footer"
  id="site-footer"
  role="contentinfo"
  aria-label={lang === 'es' ? 'Pie de página Consorcio Helitec' : 'Consorcio Helitec footer'}
  data-footer
>

  <!-- ════════════════════════════════════════════════════════════════════════
       MITAD SUPERIOR — 2 cols mobile / 3 cols desktop
       Col-right usa display:contents en desktop para que nav y contacto
       participen directamente en el grid de 3 columnas.
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__main">
    <div class="footer__inner">

      <!-- ── COL A: Identidad corporativa ──────────────────────────────── -->
      <div class="footer__col footer__col--brand">

        <a
          href="/"
          class="footer__logo-link"
          aria-label="Consorcio Helitec — Inicio"
          data-anim
          data-anim-delay="0"
        >
          <img
            class="footer__logo"
            src={logoSrc}
            alt="Consorcio Helitec"
            width="180"
            height="48"
            loading="lazy"
            decoding="async"
          />
        </a>

        <!-- Recurso rojo — reveal clip-path de izq → der -->
        <img
          src="/assets/recurso%20rojo%20helitec.png"
          class="footer__logo-deco"
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />

        <p class="footer__tagline" data-anim data-anim-delay="80">
          {lang === 'es'
            ? 'Aviación ejecutiva y aeromédica. Venezuela.'
            : 'Executive and aeromedical aviation. Venezuela.'}
        </p>

        <address class="footer__address" data-anim data-anim-delay="160">
          <p class="footer__address-line">
            {lang === 'es' ? 'Sede:' : 'HQ:'}
            &nbsp;<span class="footer__address-value">Caracas, Venezuela</span>
          </p>
          <p class="footer__address-line">
            RIF:&nbsp;<span class="footer__address-value">[DATO: RIF]</span>
          </p>
        </address>

        <div class="footer__certs" data-anim data-anim-delay="200">
          <span class="footer__cert-tag">INAC</span>
          <span class="footer__cert-tag">OACI</span>
        </div>

      </div>


      <!-- ── COL B: Wrapper nav + contacto ─────────────────────────────── -->
      <!--
        Mobile: flex-col → nav arriba, contacto abajo (col derecha del grid 2col)
        Desktop: display:contents → nav y contacto se vuelven hijos directos
                 del grid de 3 columnas (col 2 y col 3 respectivamente)
      -->
      <div class="footer__col-right">

        <!-- Navegación -->
        <nav
          class="footer__col footer__col--nav"
          aria-label={lang === 'es' ? 'Navegación del footer' : 'Footer navigation'}
        >
          <p class="footer__col-heading" data-anim data-anim-delay="60">
            {lang === 'es' ? 'Navegación' : 'Navigation'}
          </p>
          <ul class="footer__nav-list" role="list">
            {navLinks.map((link, i) => (
              <li
                class="footer__nav-item"
                data-anim
                data-anim-delay={String(120 + i * 55)}
              >
                <a class="footer__nav-link" href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Contacto B2B -->
        <div class="footer__col footer__col--contact">
          <p class="footer__col-heading" data-anim data-anim-delay="60">
            {lang === 'es' ? 'Contacto B2B' : 'B2B Contact'}
          </p>
          <ul class="footer__contact-list" role="list" data-anim data-anim-delay="140">

            <li class="footer__contact-item">
              <span class="footer__contact-icon" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="M20.52 3.48A11.9 11.9 0 0 0 12 0C5.37 0 0 5.37 0 12c0 2.12.55 4.18 1.6 6L0 24l6.17-1.57A11.94 11.94 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.22-3.48-8.52ZM12 21.94a9.9 9.9 0 0 1-5.04-1.37l-.36-.22-3.66.94.97-3.56-.24-.37A9.9 9.9 0 0 1 2.06 12C2.06 6.49 6.49 2.06 12 2.06S21.94 6.49 21.94 12 17.51 21.94 12 21.94Z" fill="currentColor"/>
                </svg>
              </span>
              <a
                class="footer__contact-link"
                href="https://wa.me/584166235254"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp operativo: +58 416 623 5254"
              >
                +58 (416) 623-5254
              </a>
            </li>

            <li class="footer__contact-item">
              <span class="footer__contact-icon" aria-hidden="true">
                <svg width="13" height="11" viewBox="0 0 14 11" fill="none">
                  <rect x="1" y="1" width="12" height="9" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M1 1L7 6.5L13 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/>
                </svg>
              </span>
              <a
                class="footer__contact-link"
                href="mailto:[DATO: email corporativo]"
                aria-label={lang === 'es' ? 'Email corporativo' : 'Corporate email'}
              >
                [DATO: email corporativo]
              </a>
            </li>

            <li class="footer__contact-item footer__contact-item--address">
              <span class="footer__contact-icon" aria-hidden="true">
                <svg width="10" height="14" viewBox="0 0 10 14" fill="none">
                  <path d="M5 1C2.79 1 1 2.79 1 5C1 8.5 5 13 5 13C5 13 9 8.5 9 5C9 2.79 7.21 1 5 1Z" stroke="currentColor" stroke-width="1.2"/>
                  <circle cx="5" cy="5" r="1.5" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </span>
              <span class="footer__contact-text">[DATO: aeropuerto/sede operativa]</span>
            </li>

          </ul>
        </div>

      </div><!-- /footer__col-right -->

    </div>
  </div>


  <!-- ════════════════════════════════════════════════════════════════════════
       MITAD INFERIOR — TARJETAS SOCIALES + BOTONES CTA
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__lower">
    <div class="footer__inner">

      <!-- ── Grid 2×2 tarjetas blancas ───────────────────────────────── -->
      <div
        class="footer__social-grid"
        role="list"
        aria-label={lang === 'es' ? 'Redes sociales' : 'Social networks'}
        data-anim
        data-anim-delay="280"
      >

        <!-- LinkedIn -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://www.linkedin.com/company/consorcio-helitec"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Consorcio Helitec (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </span>
          <span class="footer__scard-label">LinkedIn</span>
        </a>

        <!-- Instagram -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://www.instagram.com/consorciohtelitec"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Consorcio Helitec (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </span>
          <span class="footer__scard-label">Instagram</span>
        </a>

        <!-- WhatsApp -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://wa.me/584166235254"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp de Consorcio Helitec (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </span>
          <span class="footer__scard-label">WhatsApp</span>
        </a>

        <!-- Linktree -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://linktr.ee/consorciohtelitec"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Linktree de Consorcio Helitec (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <!-- Chain-link icon — representa agregador de links -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
          </span>
          <span class="footer__scard-label">Linktree</span>
        </a>

      </div><!-- /footer__social-grid -->


      <!-- ── Botones CTA apilados ──────────────────────────────────────── -->
      <div class="footer__cta-stack" data-anim data-anim-delay="360">

        <!--
          CONTACTAR — ancho y estilo EXACTAMENTE como el original.
          border-radius: 999px → override intencional por Tech Lead (Licorn-style).
        -->
        <button
          class="footer__pill-cta"
          id="footer-cta-contactar"
          type="button"
          aria-label={lang === 'es' ? 'Abrir formulario de contacto' : 'Open contact form'}
        >
          <span class="footer__pill-cta__label">
            {lang === 'es' ? 'Contactar' : 'Contact us'}
          </span>
          <svg
            class="footer__pill-cta__arrow"
            width="16"
            height="12"
            viewBox="0 0 16 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M1 6h14M10 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/>
          </svg>
        </button>

        <!-- SOLICITAR COTIZACIÓN — duplicado exacto del anterior -->
        <button
          class="footer__pill-cta"
          id="footer-cta-cotizacion"
          type="button"
          aria-label={lang === 'es' ? 'Solicitar cotización' : 'Request a quote'}
        >
          <span class="footer__pill-cta__label">
            {lang === 'es' ? 'Solicitar cotización' : 'Request a quote'}
          </span>
          <svg
            class="footer__pill-cta__arrow"
            width="16"
            height="12"
            viewBox="0 0 16 12"
            fill="none"
            aria-hidden="true"
          >
            <path d="M1 6h14M10 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/>
          </svg>
        </button>

      </div><!-- /footer__cta-stack -->

    </div>
  </div>


  <!-- ════════════════════════════════════════════════════════════════════════
       BOTTOM BAR — copyright + legal
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__bottom" data-anim data-anim-delay="460">
    <div class="footer__inner footer__bottom-inner">

      <p class="footer__copyright">
        © {currentYear} Consorcio Helitec.
        {lang === 'es' ? ' Todos los derechos reservados.' : ' All rights reserved.'}
      </p>

      <div class="footer__bottom-links">
        <a
          class="footer__bottom-link"
          href="/"
          data-no-nav
          aria-label={lang === 'es' ? 'Política de privacidad' : 'Privacy policy'}
        >
          {lang === 'es' ? 'Privacidad' : 'Privacy'}
        </a>
        <span class="footer__bottom-sep" aria-hidden="true">·</span>
        <a
          class="footer__bottom-link"
          href="/"
          data-no-nav
          aria-label={lang === 'es' ? 'Aviso legal' : 'Legal notice'}
        >
          {lang === 'es' ? 'Aviso legal' : 'Legal'}
        </a>
      </div>

    </div>
  </div>

</footer>


<style>
  /* ════════════════════════════════════════════════════════════════════════
     BASE
  ════════════════════════════════════════════════════════════════════════ */

  .footer {
    background-color: var(--c-bg);
    border-top:       1px solid var(--c-line);
  }

  .footer__inner {
    max-width:      var(--content-max);
    margin-inline:  auto;
    padding-inline: calc(var(--sidebar-w) + var(--gutter));
  }


  /* ════════════════════════════════════════════════════════════════════════
     FADE-IN ESCALONADO
  ════════════════════════════════════════════════════════════════════════ */

  [data-anim] {
    transition:
      opacity   0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }


  /* ════════════════════════════════════════════════════════════════════════
     MITAD SUPERIOR — GRID
     Mobile:  2 columnas (brand | col-right con nav+contacto apilados)
     Desktop: 3 columnas (brand | nav | contacto) vía display:contents
  ════════════════════════════════════════════════════════════════════════ */

  .footer__main {
    padding-block: clamp(40px, 7vh, 72px);
  }

  .footer__main .footer__inner {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(24px, 4vw, 40px);
    align-items:           start;
  }

  /* Wrapper mobile: flex-col apila nav encima de contacto */
  .footer__col-right {
    display:        flex;
    flex-direction: column;
    gap:            28px;
  }

  .footer__col {
    display:        flex;
    flex-direction: column;
    gap:            16px;
  }


  /* ════════════════════════════════════════════════════════════════════════
     COL A — IDENTIDAD
  ════════════════════════════════════════════════════════════════════════ */

  .footer__logo-link {
    display:    inline-block;
    line-height: 0;
  }

  .footer__logo {
    width:      clamp(100px, 14vw, 150px);
    height:     auto;
    object-fit: contain;
    opacity:    0.90;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .footer__logo-link:hover .footer__logo,
  .footer__logo-link:focus-visible .footer__logo {
    opacity: 1;
  }

  /* Recurso rojo — reveal izq → der */
  .footer__logo-deco {
    display:         block;
    width:           clamp(56px, 38%, 110px);
    height:          auto;
    object-fit:      contain;
    object-position: left center;
    margin-top:      -10px;
    clip-path:       inset(0 100% 0 0);
    transition:      clip-path 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  .footer__logo-deco.is-revealed {
    clip-path: inset(0 0% 0 0);
  }

  .footer__tagline {
    font-family: var(--font-sans);
    font-size:   clamp(0.6875rem, 1.1vw, 0.8125rem);
    font-weight: var(--fw-light);
    color:       var(--c-text-2);
    line-height: 1.55;
    margin-top:  -2px;
  }

  .footer__address {
    display:        flex;
    flex-direction: column;
    gap:            4px;
    font-style:     normal;
  }

  .footer__address-line {
    font-family:    var(--font-sans);
    font-size:      0.6875rem;
    font-weight:    var(--fw-regular);
    letter-spacing: var(--ls-wide);
    color:          var(--c-text-3);
  }

  .footer__address-value {
    color: var(--c-text-2);
  }

  .footer__certs {
    display:   flex;
    gap:       7px;
    flex-wrap: wrap;
  }

  .footer__cert-tag {
    font-family:    var(--font-sans);
    font-size:      0.5625rem;
    font-weight:    var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color:          var(--c-sky);
    padding:        3px 7px;
    border:         1px solid rgba(88, 181, 240, 0.30);
    border-radius:  var(--r-micro);
  }


  /* ════════════════════════════════════════════════════════════════════════
     COL NAV
  ════════════════════════════════════════════════════════════════════════ */

  .footer__col-heading {
    font-family:    var(--font-sans);
    font-size:      var(--text-xs);
    font-weight:    var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color:          var(--c-text-1);
    margin-bottom:  2px;
  }

  .footer__nav-list {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        0;
  }

  .footer__nav-link {
    display:     inline-block;
    padding:     4px 0;
    font-family: var(--font-sans);
    font-size:   0.8125rem;
    font-weight: var(--fw-light);
    color:       var(--c-text-2);
    text-decoration: none;
    transition:  color var(--dur-fast) var(--ease-out);
  }

  .footer__nav-link:hover,
  .footer__nav-link:focus-visible {
    color: var(--c-sky);
  }

  .footer__nav-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
    border-radius:  var(--r-micro);
  }


  /* ════════════════════════════════════════════════════════════════════════
     COL CONTACTO B2B
  ════════════════════════════════════════════════════════════════════════ */

  .footer__contact-list {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        9px;
  }

  .footer__contact-item {
    display:     flex;
    align-items: center;
    gap:         8px;
  }

  .footer__contact-item--address {
    align-items: flex-start;
  }

  .footer__contact-icon {
    display:     flex;
    align-items: center;
    flex-shrink: 0;
    color:       var(--c-sky);
    margin-top:  1px;
  }

  .footer__contact-link {
    font-family:     var(--font-sans);
    font-size:       0.75rem;
    font-weight:     var(--fw-regular);
    color:           var(--c-text-2);
    text-decoration: none;
    transition:      color var(--dur-fast) var(--ease-out);
  }

  .footer__contact-link:hover,
  .footer__contact-link:focus-visible {
    color: var(--c-text-1);
  }

  .footer__contact-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
    border-radius:  var(--r-micro);
  }

  .footer__contact-text {
    font-family: var(--font-sans);
    font-size:   0.75rem;
    font-weight: var(--fw-light);
    color:       var(--c-text-2);
    line-height: 1.5;
  }


  /* ════════════════════════════════════════════════════════════════════════
     MITAD INFERIOR
  ════════════════════════════════════════════════════════════════════════ */

  .footer__lower {
    border-top:    1px solid var(--c-line);
    padding-block: clamp(28px, 5vh, 48px);
  }

  .footer__lower .footer__inner {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            28px;
  }


  /* ════════════════════════════════════════════════════════════════════════
     TARJETAS SOCIALES — grid 2×2 mobile / 4 col desktop
     Referencia: captura adjunta — fondo blanco, ícono outline centrado,
     label abajo, borde muy sutil. Sin box-shadow.
  ════════════════════════════════════════════════════════════════════════ */

  .footer__social-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   10px;
    width:                 100%;
    max-width:             480px;
  }

  .footer__scard {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    justify-content: center;
    gap:            11px;
    padding:        22px 16px 18px;

    /* Fondo blanco — contrasta con bg oscuro del footer */
    background:    #ffffff;
    border:        1px solid rgba(0, 0, 0, 0.07);
    border-radius: 4px; /* máximo permitido */

    text-decoration: none;
    cursor:          pointer;

    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .footer__scard:hover,
  .footer__scard:focus-visible {
    background: #f2f2f2;
  }

  .footer__scard:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
  }

  /* Ícono — stroke fino sobre blanco → color oscuro */
  .footer__scard-icon {
    display:         flex;
    align-items:     center;
    justify-content: center;
    color:           #1a1a1a;
    line-height:     0;
  }

  /* Label — tipografía micro uppercase */
  .footer__scard-label {
    font-family:    var(--font-sans);
    font-size:      0.5625rem;
    font-weight:    var(--fw-medium);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color:          #333333;
    line-height:    1;
  }


  /* ════════════════════════════════════════════════════════════════════════
     CTA STACK — CONTACTAR + SOLICITAR COTIZACIÓN
     PILL CTA: border-radius 999px → override intencional Tech Lead (Licorn-style)
  ════════════════════════════════════════════════════════════════════════ */

  .footer__cta-stack {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            12px;
    width:          100%;
  }

  .footer__pill-cta {
    /* Ancho idéntico al original — centrado */
    width:      100%;
    max-width:  clamp(280px, 55vw, 560px);

    display:         flex;
    align-items:     center;
    justify-content: center;
    gap:             14px;

    padding: clamp(16px, 2.2vh, 22px) clamp(28px, 5vw, 48px);

    /* Ghost pill — borde elegante sobre oscuro */
    background:    transparent;
    border:        1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px; /* Excepción autorizada — Tech Lead */

    font-family:    var(--font-sans);
    font-size:      clamp(0.6875rem, 1.1vw, 0.8125rem);
    font-weight:    var(--fw-medium);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color:          var(--c-text-1);
    cursor:         pointer;
    text-decoration: none;

    transition:
      border-color     var(--dur-mid) var(--ease-out),
      background-color var(--dur-mid) var(--ease-out),
      color            var(--dur-fast) var(--ease-out);
  }

  .footer__pill-cta:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color:     rgba(255, 255, 255, 0.50);
    color:            var(--c-white);
