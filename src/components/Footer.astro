  .footer__bottom-link {
    font-family:     var(--font-sans);
    font-size:       0.75rem;
    font-weight:     var(--fw-regular);
    color:           var(--c-text-3);
    text-decoration: none;
    transition:      color var(--dur-fast) var(--ease-out);
