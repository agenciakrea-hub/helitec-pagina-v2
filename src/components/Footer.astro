---
/**
 * Footer.astro — Consorcio Helitec  v4 (Refactorización final)
 *
 * ESTRUCTURA v4:
 *   CABECERA:  Logo + tagline centrados, ancho completo.
 *   CUERPO:    Grid 2 columnas fijo (nav | contacto B2B) con datos reales.
 *   INFERIOR:  Grid 2×2 social cards + 2 CTAs blancos con texto negro.
 *
 * OVERRIDES autorizados por cliente (v4):
 *   · .footer__scard   border-radius: 20px  (client override — "más redondas")
 *   · .footer__pill-cta border-radius: 999px (Tech Lead override previo)
 *   · .footer__pill-cta background: white / color: black (client override v4)
 *
 * Reglas anti-slop respetadas en el resto del componente:
 *   PROHIBIDO box-shadow        — ✓
 *   PROHIBIDO linear-gradient   — ✓
 *   object-fit: cover/contain   — ✓
 */

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const navLinks = [
  { href: '#por-que-helitec', label: lang === 'es' ? 'Por qué Helitec' : 'Why Helitec' },
  { href: '#flota',           label: lang === 'es' ? 'Nuestra Flota'   : 'Our Fleet'   },
  { href: '#empresa',         label: lang === 'es' ? 'La Empresa'       : 'About Us'    },
  { href: '#seguridad',       label: lang === 'es' ? 'Seguridad'        : 'Safety'      },
  { href: '#contacto',        label: lang === 'es' ? 'Contacto B2B'     : 'B2B Contact' },
];

const logoSrc   = '/assets/Logo-Helitec-horiz-no-bkg-1-blanco.png';
const currentYear = new Date().getFullYear();
---


<footer
  class="footer"
  id="site-footer"
  role="contentinfo"
  aria-label={lang === 'es' ? 'Pie de página Consorcio Helitec' : 'Consorcio Helitec footer'}
  data-footer
>

  <!-- ════════════════════════════════════════════════════════════════════════
       CABECERA — Logo + tagline centrados, ancho completo
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__header" data-anim data-anim-delay="0">
    <div class="footer__inner footer__header-inner">

      <a
        href="/"
        class="footer__logo-link"
        aria-label="Consorcio Helitec — Inicio"
      >
        <img
          class="footer__logo"
          src={logoSrc}
          alt="Consorcio Helitec"
          width="200"
          height="52"
          loading="lazy"
          decoding="async"
        />
      </a>

      <p class="footer__tagline">
        {lang === 'es'
          ? 'Aviación ejecutiva y aeromédica. Venezuela.'
          : 'Executive and aeromedical aviation. Venezuela.'}
      </p>

    </div>
  </div>


  <!-- ════════════════════════════════════════════════════════════════════════
       CUERPO — Grid 2 columnas: NAVEGACIÓN | CONTACTO B2B
       2 cols fijas incluso en mobile (compact font en col contacto)
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__main">
    <div class="footer__inner">

      <!-- ── COL 1: Navegación ──────────────────────────────────────────── -->
      <nav
        class="footer__col footer__col--nav"
        aria-label={lang === 'es' ? 'Navegación del footer' : 'Footer navigation'}
      >
        <p class="footer__col-heading" data-anim data-anim-delay="60">
          {lang === 'es' ? 'Navegación' : 'Navigation'}
        </p>
        <ul class="footer__nav-list" role="list">
          {navLinks.map((link, i) => (
            <li
              class="footer__nav-item"
              data-anim
              data-anim-delay={String(120 + i * 50)}
            >
              <a class="footer__nav-link" href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>


      <!-- ── COL 2: Contacto B2B ─────────────────────────────────────────── -->
      <div class="footer__col footer__col--contact">

        <p class="footer__col-heading" data-anim data-anim-delay="60">
          {lang === 'es' ? 'Contacto B2B' : 'B2B Contact'}
        </p>

        <ul class="footer__contact-list" role="list" data-anim data-anim-delay="130">

          <!-- Dirección -->
          <li class="footer__contact-item footer__contact-item--top">
            <span class="footer__contact-icon" aria-hidden="true">
              <!-- Pin / location -->
              <svg width="11" height="14" viewBox="0 0 10 14" fill="none">
                <path d="M5 1C2.79 1 1 2.79 1 5C1 8.5 5 13 5 13C5 13 9 8.5 9 5C9 2.79 7.21 1 5 1Z" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="5" cy="5" r="1.5" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            </span>
            <span class="footer__contact-text">CCCT, Chuao. Caracas, Venezuela.</span>
          </li>

          <!-- Email -->
          <li class="footer__contact-item footer__contact-item--top">
            <span class="footer__contact-icon" aria-hidden="true">
              <!-- Envelope -->
              <svg width="14" height="11" viewBox="0 0 14 11" fill="none">
                <rect x="1" y="1" width="12" height="9" stroke="currentColor" stroke-width="1.2"/>
                <path d="M1 1L7 6.5L13 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/>
              </svg>
            </span>
            <a
              class="footer__contact-link"
              href="mailto:Info@helitec-main.com"
              aria-label="Email corporativo"
            >
              Info@helitec-main.com
            </a>
          </li>

          <!-- Teléfono 1 — Oficinas centrales -->
          <li class="footer__contact-item footer__contact-item--top">
            <span class="footer__contact-icon" aria-hidden="true">
              <!-- Phone handset -->
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.77 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.68 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6 6l1.06-1.06a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <div class="footer__contact-block">
              <span class="footer__contact-sublabel">
                {lang === 'es' ? 'Oficinas centrales' : 'Main office'}
              </span>
              <a
                class="footer__contact-link"
                href="tel:+582129590401"
                aria-label="Teléfono oficinas centrales"
              >
                +58 (212) 959-0401
              </a>
            </div>
          </li>

          <!-- Teléfono 2 — Central de Emergencias -->
          <li class="footer__contact-item footer__contact-item--top">
            <span class="footer__contact-icon footer__contact-icon--alert" aria-hidden="true">
              <!-- Headset / emergency dispatch -->
              <svg width="14" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/>
                <path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
              </svg>
            </span>
            <div class="footer__contact-block">
              <span class="footer__contact-sublabel footer__contact-sublabel--alert">
                {lang === 'es' ? 'Central de Emergencias y Traslados' : 'Emergency & Transfer Center'}
              </span>
              <a
                class="footer__contact-link"
                href="tel:+582129596385"
                aria-label="Central de emergencias y traslados"
              >
                +58 212 9596385
              </a>
            </div>
          </li>

        </ul>
      </div>

    </div>
  </div>


  <!-- ════════════════════════════════════════════════════════════════════════
       MITAD INFERIOR — TARJETAS SOCIALES + BOTONES CTA
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__lower">
    <div class="footer__inner">

      <!-- Grid 2×2 tarjetas blancas redondeadas -->
      <div
        class="footer__social-grid"
        role="list"
        aria-label={lang === 'es' ? 'Redes sociales' : 'Social networks'}
        data-anim
        data-anim-delay="300"
      >

        <!-- LinkedIn -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://www.linkedin.com/company/consorcio-helitec"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </span>
          <span class="footer__scard-label">LinkedIn</span>
        </a>

        <!-- Instagram -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://www.instagram.com/consorciohtelitec"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </span>
          <span class="footer__scard-label">Instagram</span>
        </a>

        <!-- WhatsApp -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://wa.me/584166235254"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </span>
          <span class="footer__scard-label">WhatsApp</span>
        </a>

        <!-- Linktree -->
        <a
          class="footer__scard"
          role="listitem"
          href="https://linktr.ee/consorciohtelitec"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Linktree (abre en nueva pestaña)"
        >
          <span class="footer__scard-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
          </span>
          <span class="footer__scard-label">Linktree</span>
        </a>

      </div><!-- /footer__social-grid -->


      <!-- CTAs apilados — blancos con texto negro (client override v4) -->
      <div class="footer__cta-stack" data-anim data-anim-delay="380">

        <button
          class="footer__pill-cta"
          id="footer-cta-contactar"
          type="button"
          aria-label={lang === 'es' ? 'Abrir formulario de contacto' : 'Open contact form'}
        >
          <span class="footer__pill-cta__label">
            {lang === 'es' ? 'Contactar' : 'Contact us'}
          </span>
          <svg class="footer__pill-cta__arrow" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <path d="M1 6h14M10 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/>
          </svg>
        </button>

        <button
          class="footer__pill-cta"
          id="footer-cta-cotizacion"
          type="button"
          aria-label={lang === 'es' ? 'Solicitar cotización' : 'Request a quote'}
        >
          <span class="footer__pill-cta__label">
            {lang === 'es' ? 'Solicitar cotización' : 'Request a quote'}
          </span>
          <svg class="footer__pill-cta__arrow" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <path d="M1 6h14M10 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"/>
          </svg>
        </button>

      </div>

    </div>
  </div>


  <!-- ════════════════════════════════════════════════════════════════════════
       BOTTOM BAR
  ════════════════════════════════════════════════════════════════════════ -->
  <div class="footer__bottom" data-anim data-anim-delay="460">
    <div class="footer__inner footer__bottom-inner">

      <p class="footer__copyright">
        © {currentYear} Consorcio Helitec.
        {lang === 'es' ? ' Todos los derechos reservados.' : ' All rights reserved.'}
      </p>

      <div class="footer__bottom-links">
        <a class="footer__bottom-link" href="/" data-no-nav>
          {lang === 'es' ? 'Privacidad' : 'Privacy'}
        </a>
        <span class="footer__bottom-sep" aria-hidden="true">·</span>
        <a class="footer__bottom-link" href="/" data-no-nav>
          {lang === 'es' ? 'Aviso legal' : 'Legal'}
        </a>
      </div>

    </div>
  </div>

</footer>


<style>
  /* ════════════════════════════════════════════════════════════════════════
     BASE
  ════════════════════════════════════════════════════════════════════════ */

  .footer {
    background-color: var(--c-bg);
    border-top:       1px solid var(--c-line);
  }

  .footer__inner {
    max-width:      var(--content-max);
    margin-inline:  auto;
    padding-inline: var(--gutter);
  }


  /* ════════════════════════════════════════════════════════════════════════
     FADE-IN ESCALONADO
  ════════════════════════════════════════════════════════════════════════ */

  [data-anim] {
    transition:
      opacity   0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }


  /* ════════════════════════════════════════════════════════════════════════
     CABECERA — logo + tagline centrados
  ════════════════════════════════════════════════════════════════════════ */

  .footer__header {
    padding-block: clamp(36px, 6vh, 56px) clamp(24px, 4vh, 36px);
    border-bottom: 1px solid var(--c-line);
  }

  .footer__header-inner {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            14px;
    text-align:     center;
  }

  .footer__logo-link {
    display:    inline-block;
    line-height: 0;
  }

  .footer__logo {
    width:      clamp(140px, 30vw, 200px);
    height:     auto;
    object-fit: contain;
    opacity:    0.92;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .footer__logo-link:hover .footer__logo,
  .footer__logo-link:focus-visible .footer__logo {
    opacity: 1;
  }

  .footer__logo-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 4px;
    border-radius:  var(--r-micro);
  }

  .footer__tagline {
    font-family:    var(--font-sans);
    font-size:      clamp(0.6875rem, 1.4vw, 0.875rem);
    font-weight:    var(--fw-light);
    letter-spacing: var(--ls-wide);
    color:          var(--c-text-2);
    line-height:    1.5;
  }


  /* ════════════════════════════════════════════════════════════════════════
     CUERPO — Grid 2 columnas fijo
  ════════════════════════════════════════════════════════════════════════ */

  .footer__main {
    padding-block: clamp(28px, 5vh, 48px);
    border-bottom: 1px solid var(--c-line);
  }

  .footer__main .footer__inner {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(20px, 4vw, 48px);
    align-items:           start;
  }

  .footer__col {
    display:        flex;
    flex-direction: column;
    gap:            14px;
  }

  .footer__col-heading {
    font-family:    var(--font-sans);
    font-size:      var(--text-xs);
    font-weight:    var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color:          var(--c-text-1);
    margin-bottom:  2px;
  }


  /* ════════════════════════════════════════════════════════════════════════
     COL 1 — NAVEGACIÓN
  ════════════════════════════════════════════════════════════════════════ */

  .footer__nav-list {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        0;
  }

  .footer__nav-link {
    display:         inline-block;
    padding:         4px 0;
    font-family:     var(--font-sans);
    font-size:       clamp(0.75rem, 1.4vw, 0.875rem);
    font-weight:     var(--fw-light);
    color:           var(--c-text-2);
    text-decoration: none;
    transition:      color var(--dur-fast) var(--ease-out);
  }

  .footer__nav-link:hover,
  .footer__nav-link:focus-visible {
    color: var(--c-sky);
  }

  .footer__nav-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
    border-radius:  var(--r-micro);
  }


  /* ════════════════════════════════════════════════════════════════════════
     COL 2 — CONTACTO B2B
  ════════════════════════════════════════════════════════════════════════ */

  .footer__contact-list {
    list-style: none;
    padding:    0;
    margin:     0;
    display:    flex;
    flex-direction: column;
    gap:        12px;
  }

  .footer__contact-item {
    display:  flex;
    gap:      8px;
  }

  .footer__contact-item--top {
    align-items: flex-start;
  }

  .footer__contact-icon {
    display:     flex;
    align-items: flex-start;
    flex-shrink: 0;
    color:       var(--c-sky);
    padding-top: 2px;
  }

  /* Ícono de emergencias — acento rojo */
  .footer__contact-icon--alert {
    color: var(--c-red);
  }

  /* Bloque para items con sublabel + link apilados */
  .footer__contact-block {
    display:        flex;
    flex-direction: column;
    gap:            2px;
  }

  .footer__contact-sublabel {
    font-family:    var(--font-sans);
    font-size:      0.5625rem;
    font-weight:    var(--fw-semibold);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color:          var(--c-text-3);
    line-height:    1.3;
  }

  .footer__contact-sublabel--alert {
    color: var(--c-red);
    opacity: 0.8;
  }

  .footer__contact-link {
    font-family:     var(--font-sans);
    font-size:       clamp(0.6875rem, 1.3vw, 0.8125rem);
    font-weight:     var(--fw-regular);
    color:           var(--c-text-2);
    text-decoration: none;
    line-height:     1.4;
    transition:      color var(--dur-fast) var(--ease-out);
  }

  .footer__contact-link:hover,
  .footer__contact-link:focus-visible {
    color: var(--c-text-1);
  }

  .footer__contact-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
    border-radius:  var(--r-micro);
  }

  .footer__contact-text {
    font-family: var(--font-sans);
    font-size:   clamp(0.6875rem, 1.3vw, 0.8125rem);
    font-weight: var(--fw-light);
    color:       var(--c-text-2);
    line-height: 1.4;
  }


  /* ════════════════════════════════════════════════════════════════════════
     MITAD INFERIOR
  ════════════════════════════════════════════════════════════════════════ */

  .footer__lower {
    padding-block: clamp(28px, 5vh, 48px);
  }

  .footer__lower .footer__inner {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            24px;
  }


  /* ════════════════════════════════════════════════════════════════════════
     TARJETAS SOCIALES
     CLIENT OVERRIDE v4: border-radius: 20px
     ("mucho más redondas, similares a los botones de abajo")
  ════════════════════════════════════════════════════════════════════════ */

  .footer__social-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   10px;
    width:                 100%;
    max-width:             480px;
  }

  .footer__scard {
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             11px;
    padding:         22px 16px 18px;

    background:    #ffffff;
    border:        1px solid rgba(0, 0, 0, 0.07);
    /* CLIENT OVERRIDE — más redondas que el límite estándar de 4px */
    border-radius: 20px;

    text-decoration: none;
    cursor:          pointer;
    transition:      background-color var(--dur-fast) var(--ease-out);
  }

  .footer__scard:hover,
  .footer__scard:focus-visible {
    background: #f0f0f0;
  }

  .footer__scard:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
  }

  .footer__scard-icon {
    display:         flex;
    align-items:     center;
    justify-content: center;
    color:           #1a1a1a;
    line-height:     0;
  }

  .footer__scard-label {
    font-family:    var(--font-sans);
    font-size:      0.5625rem;
    font-weight:    var(--fw-medium);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color:          #333333;
    line-height:    1;
  }


  /* ════════════════════════════════════════════════════════════════════════
     BOTONES CTA — PÍLDORA BLANCA CON TEXTO NEGRO
     CLIENT OVERRIDE v4: background white / color black
     Override previo Tech Lead: border-radius 999px (sigue vigente)
  ════════════════════════════════════════════════════════════════════════ */

  .footer__cta-stack {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            12px;
    width:          100%;
  }

  .footer__pill-cta {
    width:      100%;
    max-width:  clamp(280px, 55vw, 560px);

    display:         flex;
    align-items:     center;
    justify-content: center;
    gap:             14px;

    padding: clamp(16px, 2.2vh, 22px) clamp(28px, 5vw, 48px);

    /* CLIENT OVERRIDE v4 — fondo blanco, texto negro */
    background:    #ffffff;
    border:        1px solid #ffffff;
    border-radius: 999px; /* Tech Lead override previo — Licorn-style */

    font-family:    var(--font-sans);
    font-size:      clamp(0.6875rem, 1.1vw, 0.8125rem);
    font-weight:    var(--fw-medium);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    /* Negro para contrastar con blanco */
    color:          #0a0a0a;
    cursor:         pointer;
    text-decoration: none;

    transition:
      background-color var(--dur-mid) var(--ease-out),
      border-color     var(--dur-mid) var(--ease-out),
      color            var(--dur-fast) var(--ease-out);
  }

  .footer__pill-cta:hover {
    background-color: #e8e8e8;
    border-color:     #e8e8e8;
    color:            #0a0a0a;
  }

  .footer__pill-cta:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 4px;
    border-radius:  999px;
  }

  .footer__pill-cta__label {
    flex-shrink: 0;
  }

  /* Flecha — hereda el negro del botón; desliza en hover */
  .footer__pill-cta__arrow {
    flex-shrink: 0;
    transition:  transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer__pill-cta:hover .footer__pill-cta__arrow,
  .footer__pill-cta:focus-visible .footer__pill-cta__arrow {
    transform: translateX(6px);
  }


  /* ════════════════════════════════════════════════════════════════════════
     BOTTOM BAR
  ════════════════════════════════════════════════════════════════════════ */

  .footer__bottom {
    border-top:    1px solid var(--c-line);
    padding-block: 20px;
  }

  .footer__bottom-inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    flex-wrap:       wrap;
    gap:             12px;
  }

  .footer__copyright {
    font-family:    var(--font-sans);
    font-size:      0.75rem;
    font-weight:    var(--fw-regular);
    letter-spacing: var(--ls-wide);
    color:          var(--c-text-3);
    line-height:    1.5;
  }

  .footer__bottom-links {
    display:     flex;
    align-items: center;
    gap:         8px;
  }

  .footer__bottom-link {
    font-family:     var(--font-sans);
    font-size:       0.75rem;
    font-weight:     var(--fw-regular);
    color:           var(--c-text-3);
    text-decoration: none;
    transition:      color var(--dur-fast) var(--ease-out);
  }

  .footer__bottom-link:hover,
  .footer__bottom-link:focus-visible {
    color: var(--c-sky);
  }

  .footer__bottom-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
    border-radius:  var(--r-micro);
  }

  .footer__bottom-sep {
    font-size:   0.75rem;
    color:       var(--c-text-3);
    user-select: none;
  }


  /* ════════════════════════════════════════════════════════════════════════
     UX CRÍTICO — OCULTAR BOTONES FLOTANTES CON EL FOOTER VISIBLE
  ════════════════════════════════════════════════════════════════════════ */

  :global(body.footer-visible .slcta__trigger) {
    opacity:        0 !important;
    visibility:     hidden !important;
    pointer-events: none !important;
    transition:
      opacity    0.35s var(--ease-out),
      visibility 0s    linear 0.35s;
  }

  :global(body.footer-visible .csheet__contact-strip),
  :global(body.footer-visible .csheet__linktree-btn) {
    opacity:        0 !important;
    visibility:     hidden !important;
    pointer-events: none !important;
    transition:
      opacity    0.35s var(--ease-out),
      visibility 0s    linear 0.35s;
  }


  /* ════════════════════════════════════════════════════════════════════════
     RESPONSIVE
  ════════════════════════════════════════════════════════════════════════ */

  /* Tablet ≥640px: social cards en fila de 4 */
  @media (min-width: 640px) {
    .footer__social-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width:             600px;
    }

    .footer__main .footer__inner {
      gap: clamp(32px, 5vw, 64px);
    }
  }

  /* Desktop ≥1024px: padding con sidebar */
  @media (min-width: 1024px) {
    .footer__inner {
      padding-inline: calc(var(--sidebar-w) + var(--gutter));
    }

    .footer__social-grid {
      max-width: 560px;
    }

    .footer__main .footer__inner {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  /* Mobile pequeño <480px: ajustar tipografía contacto */
  @media (max-width: 479px) {
    .footer__contact-link,
    .footer__contact-text {
      font-size: 0.6875rem;
    }

    .footer__bottom-inner {
      flex-direction: column;
      align-items:    flex-start;
      gap:            8px;
    }

    .footer__pill-cta {
      max-width: 100%;
    }
  }
</style>


<script>
  /**
   * Footer v4 — Controller
   *
   * 1. Staggered fade-in por [data-anim].
   * 2. body.footer-visible → oculta botones flotantes.
   * 3. CONTACTAR + SOLICITAR COTIZACIÓN → disparan ContactSheet.
   */
  (function () {
    'use strict';

    var footer = document.querySelector('[data-footer]');
    if (!footer) return;

    /* ── 1. Staggered fade-in ────────────────────────────────────────── */

    var animEls = footer.querySelectorAll('[data-anim]');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reducedMotion) {
      animEls.forEach(function (el) {
        el.style.opacity   = '0';
        el.style.transform = 'translateY(20px)';
      });
    }

    var animObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        animEls.forEach(function (el) {
          if (reducedMotion) {
            el.style.opacity   = '1';
            el.style.transform = 'none';
            return;
          }
          var delay = parseInt(el.dataset.animDelay || '0', 10);
          setTimeout(function () {
            el.style.opacity   = '1';
            el.style.transform = 'translateY(0)';
          }, delay);
        });
        animObs.disconnect();
      });
    }, { threshold: 0.04 });

    animObs.observe(footer);


    /* ── 2. body.footer-visible → oculta FABs ───────────────────────── */

    var fabsObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        document.body.classList.toggle('footer-visible', entry.isIntersecting);
      });
    }, { threshold: 0, rootMargin: '0px 0px 0px 0px' });

    fabsObs.observe(footer);


    /* ── 3. CTAs → ContactSheet ──────────────────────────────────────── */

    function triggerContactSheet() {
      var btn = document.getElementById('csheet-trigger');
      if (btn) btn.click();
    }

    var btnC = document.getElementById('footer-cta-contactar');
    var btnQ = document.getElementById('footer-cta-cotizacion');
    if (btnC) btnC.addEventListener('click', triggerContactSheet);
    if (btnQ) btnQ.addEventListener('click', triggerContactSheet);

  })();
</script>
