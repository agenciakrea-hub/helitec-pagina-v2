  }

  .footer__bottom-link:focus-visible {
    outline:        2px solid var(--c-sky);
    outline-offset: 2px;
    border-radius:  var(--r-micro);
  }

  .footer__bottom-sep {
    font-size:   0.75rem;
    color:       var(--c-text-3);
    user-select: none;
  }


  /* ════════════════════════════════════════════════════════════════════════
     UX CRÍTICO — OCULTAR BOTONES FLOTANTES CUANDO EL FOOTER ES VISIBLE
  ════════════════════════════════════════════════════════════════════════ */

  :global(body.footer-visible .slcta__trigger) {
    opacity:        0 !important;
    visibility:     hidden !important;
    pointer-events: none !important;
    transition:
      opacity    0.35s var(--ease-out),
      visibility 0s    linear 0.35s;
  }

  :global(body.footer-visible .csheet__fabs) {
    opacity:        0 !important;
    visibility:     hidden !important;
    pointer-events: none !important;
    transition:
      opacity    0.35s var(--ease-out),
      visibility 0s    linear 0.35s;
  }


  /* ════════════════════════════════════════════════════════════════════════
     RESPONSIVE
  ════════════════════════════════════════════════════════════════════════ */

  /* Tablet ≥640px: social cards en fila de 4 */
  @media (min-width: 640px) {
    .footer__social-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width:             600px;
    }

    .footer__bottom-inner {
      flex-direction: row;
    }
  }

  /* Desktop ≥1024px: grid 3 columnas original */
  @media (min-width: 1024px) {
    .footer__inner {
      padding-inline: calc(var(--sidebar-w) + var(--gutter));
    }

    .footer__main .footer__inner {
      grid-template-columns: 1.4fr 1fr 1.2fr;
      gap:                   clamp(32px, 5vw, 64px);
    }

    /*
     * display:contents convierte el wrapper en invisible para el layout:
     * footer__col--nav y footer__col--contact se vuelven hijos directos
     * del grid de 3 columnas (col 2 y col 3 respectivamente).
     */
    .footer__col-right {
      display: contents;
    }

    .footer__social-grid {
      max-width: 100%;
    }

    .footer__lower .footer__inner {
      align-items: center;
    }
  }

  /* Mobile pequeño <640px: padding reducido, layout 2-col sostenido */
  @media (max-width: 639px) {
    .footer__inner {
      padding-inline: var(--gutter);
    }

    .footer__main .footer__inner {
      gap: 18px;
    }

    .footer__bottom-inner {
      flex-direction: column;
      align-items:    flex-start;
      gap:            8px;
    }

    .footer__pill-cta {
      max-width: 100%;
    }
  }
</style>


<script>
  /**
   * Footer v3 — Controller unificado
   *
   * 1. Staggered fade-in: IntersectionObserver activa data-anim con delay.
   * 2. Footer visible → body.footer-visible: oculta botones flotantes.
   * 3. CONTACTAR → dispara csheet-trigger.
   * 4. SOLICITAR COTIZACIÓN → dispara csheet-trigger (mismo panel).
   * 5. Recurso rojo: reveal clip-path al entrar en viewport.
   */
  (function () {
    'use strict';

    var footer = document.querySelector('[data-footer]');
    if (!footer) return;

    /* ── 1. Staggered fade-in ────────────────────────────────────────── */

    var animEls = footer.querySelectorAll('[data-anim]');
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reducedMotion) {
      animEls.forEach(function (el) {
        el.style.opacity   = '0';
        el.style.transform = 'translateY(20px)';
      });
    }

    var animObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;

        animEls.forEach(function (el) {
          if (reducedMotion) {
            el.style.opacity   = '1';
            el.style.transform = 'none';
            return;
          }
          var delay = parseInt(el.dataset.animDelay || '0', 10);
          setTimeout(function () {
            el.style.opacity   = '1';
            el.style.transform = 'translateY(0)';
          }, delay);
        });

        animObs.disconnect();
      });
    }, { threshold: 0.04 });

    animObs.observe(footer);


    /* ── 2. body.footer-visible → oculta botones flotantes ─────────── */

    var fabsObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          document.body.classList.add('footer-visible');
        } else {
          document.body.classList.remove('footer-visible');
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px 0px 0px' });

    fabsObs.observe(footer);


    /* ── 3 & 4. CTAs → disparan ContactSheet ───────────────────────── */

    function triggerContactSheet() {
      var csBtn = document.getElementById('csheet-trigger');
      if (csBtn) csBtn.click();
    }

    var btnContactar   = document.getElementById('footer-cta-contactar');
    var btnCotizacion  = document.getElementById('footer-cta-cotizacion');

    if (btnContactar)  btnContactar.addEventListener('click', triggerContactSheet);
    if (btnCotizacion) btnCotizacion.addEventListener('click', triggerContactSheet);


    /* ── 5. Recurso rojo — reveal clip-path ─────────────────────────── */

    var deco = footer.querySelector('.footer__logo-deco');
    if (deco) {
      var decoObs = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          deco.classList.add('is-revealed');
          decoObs.disconnect();
        }
      }, { threshold: 0.3 });
      decoObs.observe(deco);
    }

  })();
</script>
